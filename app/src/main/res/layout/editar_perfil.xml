<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">


        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tituloEditarPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Editar perfil"
            android:textSize="26sp"
            android:textColor="#FFD700"
            android:fontFamily="@font/michroma"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"/>


        <!-- FOTO DE PERFIL -->
        <ImageView
            android:id="@+id/imgPerfil"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/tituloEditarPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>


        <!-- BOTÓN CAMBIAR FOTO -->
        <Button
            android:id="@+id/btnCambiarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cambiar foto"
            android:textColor="#121212"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/imgPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>


        <!-- BOTÓN ELIMINAR FOTO -->
        <Button
            android:id="@+id/btnEliminarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar foto"
            android:textColor="#FFD700"
            android:backgroundTint="#333333"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnCambiarFoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>


        <!-- CAMPO NOMBRE -->
        <EditText
            android:id="@+id/editNombre"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Nombre"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:fontFamily="@font/michroma"
            android:background="@drawable/edittext_box"
            android:padding="12dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/btnEliminarFoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>


        <!-- CAMPO CORREO (solo lectura) -->
        <EditText
            android:id="@+id/editCorreo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Correo electrónico"
            android:enabled="false"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:fontFamily="@font/michroma"
            android:background="@drawable/edittext_box"
            android:padding="12dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/editNombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>


        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarCambios"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="Guardar cambios"
            android:textColor="#121212"
            android:textStyle="bold"
            android:textSize="18sp"
            android:backgroundTint="#FFD700"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/editCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>


        <!-- BOTÓN CANCELAR -->
        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="Cancelar"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:backgroundTint="#333333"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnGuardarCambios"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
