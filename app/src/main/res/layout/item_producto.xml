<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardUseCompatPadding="true"
    card_view:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">


    <!-- 🔥 Fondo con borde dorado aplicado aquí -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/card_borde_amarillo">


        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del producto" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">


            <TextView
                android:id="@+id/textNombreProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del producto"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/textDescripcionProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Breve descripción del producto"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />


            <TextView
                android:id="@+id/textServiciosUsados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usado en: Lavado Premium, Detailing Exterior"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>


