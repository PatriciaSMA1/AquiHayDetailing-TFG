<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">


        <!-- Header reutilizable -->
        <include
            android:id="@+id/headerMenu"
            layout="@layout/header_menu" />


        <TextView
            android:id="@+id/textTituloProductos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Productos que utilizamos"
            android:fontFamily="@font/michroma"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/headerMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="35dp" />


        <!-- Spinner para filtrar por categoría -->
        <Spinner
            android:id="@+id/spinnerCategorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFD700"
            android:popupBackground="#1E1E1E"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/textTituloProductos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Lista de productos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProductos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/spinnerCategorias"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="#F4C300"
        app:itemIconSize="30dp"
        app:itemTextAppearance="@style/EstiloMenuLateral"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>