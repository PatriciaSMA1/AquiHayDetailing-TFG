<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardUseCompatPadding="true"
    card_view:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">


    <!-- Contenedor con borde dorado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_borde_amarillo">


        <!-- Nombre del servicio -->
        <TextView
            android:id="@+id/textNombreServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del servicio"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- Lista de tareas -->
        <TextView
            android:id="@+id/textTareasIncluidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Tarea 1\n• Tarea 2\n• Tarea 3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="8dp" />


        <!-- Tiempo estimado -->
        <TextView
            android:id="@+id/textTiempoEstimado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiempo estimado: 2 horas"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />


        <!-- Botón reservar -->
        <Button
            android:id="@+id/btnReservarServicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservar"
            android:textColor="#000000"
            android:backgroundTint="#FFD700"
            android:layout_marginTop="14dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_gravity="end" />

    </LinearLayout>

</androidx.cardview.widget.CardView>



