<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:paddingTop="48dp"
            android:background="#121212">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tituloRecuperar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="43dp"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/michroma"
                android:gravity="center"
                android:text="Recuperar contraseña"
                android:textColor="#FFD700"
                android:textSize="24sp"
                app:layout_constraintBottom_toTopOf="@+id/editCorreoRecuperar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- CAMPO CORREO (estrecho con márgenes) -->
            <EditText
                android:id="@+id/editCorreoRecuperar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:hint="Correo electrónico"
                android:fontFamily="@font/michroma"
                android:textColor="#000000"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/edittext_box"
                android:padding="12dp"
                android:textSize="16sp"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"
                app:layout_constraintTop_toBottomOf="@id/tituloRecuperar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp"/>

            <!-- BOTÓN ENVIAR (estrecho con márgenes) -->
            <Button
                android:id="@+id/btnEnviarRecuperacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Enviar correo"
                android:textColor="#121212"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#FFD700"
                android:padding="14dp"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"
                app:layout_constraintTop_toBottomOf="@id/editCorreoRecuperar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp"/>

            <!-- BOTÓN VOLVER (estrecho con márgenes) -->
            <Button
                android:id="@+id/btnVolverLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Volver al inicio"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#333333"
                android:padding="14dp"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"
                app:layout_constraintTop_toBottomOf="@id/btnEnviarRecuperacion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</ScrollView>