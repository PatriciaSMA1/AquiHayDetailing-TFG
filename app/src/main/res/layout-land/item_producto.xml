<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    card_view:cardCornerRadius="10dp"
    card_view:cardUseCompatPadding="true"
    card_view:cardElevation="3dp"
    android:foreground="?attr/selectableItemBackground">

    <!-- Fondo con borde dorado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/card_borde_amarillo">

        <!-- Imagen más pequeña para horizontal -->
        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_margin="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del producto" />

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <!-- Nombre del producto -->
            <TextView
                android:id="@+id/textNombreProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del producto"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/textDescripcionProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Breve descripción del producto"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

            <!-- Servicios donde se usa -->
            <TextView
                android:id="@+id/textServiciosUsados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usado en: Lavado Premium, Detailing Exterior"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
