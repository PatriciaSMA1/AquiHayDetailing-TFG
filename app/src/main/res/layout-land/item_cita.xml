<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/card_cita"
    android:layout_marginBottom="12dp">

    <!-- SERVICIO -->
    <TextView
        android:id="@+id/textServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#111"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/michroma"/>

    <!-- FECHA -->
    <TextView
        android:id="@+id/textFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#555"
        android:textSize="13sp"
        android:layout_marginTop="4dp"/>

    <!-- HORA -->
    <TextView
        android:id="@+id/textHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#555"
        android:textSize="13sp"
        android:layout_marginTop="2dp"/>

    <!-- PRECIO -->
    <TextView
        android:id="@+id/textPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <!-- TAMAÑO -->
    <TextView
        android:id="@+id/textTamaño"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#444"
        android:textSize="13sp"
        android:layout_marginTop="4dp"/>

    <!-- ESTADO (TEXTVIEW) -->
    <TextView
        android:id="@+id/textEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/michroma"
        android:gravity="center"
        android:background="@drawable/estado_badge"/>

    <!-- BOTÓN CANCELAR (BOTÓN) -->
    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Cancelar Reserva"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D32F2F"
        android:fontFamily="@font/michroma"
        android:textAllCaps="false"
        android:visibility="gone" />

</LinearLayout>